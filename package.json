{
  "name": "dsh-yyz-kaka",
  "version": "0.2.1",
  "description": "咔咔：一只住在 DeepSeek Harness 里的小螃蟹工作助手。独立预设人格（不加载工作区 AGENTS.md）、跨会话共享的记忆与主人画像、日记、画笔（SVG 自动转 PNG）、螃蟹声（没有任何 TTS，只会咔嚓/叩壳/咕噜/吱吱）、输入框旁的宠物与 5 秒生命线程。Kaka is a crab companion for DeepSeek Harness: its own agent preset, shared memory and portrait, a diary, a SVG pen, crab sounds only (no TTS), a desktop pet and a 5-second life thread.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.png",
  "license": "MIT",
  "author": "WJ",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "persona",
    "desktop-pet",
    "crab",
    "sounds",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriusWJ/dsh-yyz-kaka.git"
  },
  "homepage": "https://github.com/SiriusWJ/dsh-yyz-kaka#readme",
  "bugs": {
    "url": "https://github.com/SiriusWJ/dsh-yyz-kaka/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./preset/kaka-memory.mjs": "./preset/kaka-memory.mjs",
    "./preset/kaka-voice.mjs": "./preset/kaka-voice.mjs",
    "./preset/kaka-draw.mjs": "./preset/kaka-draw.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./sprite": "./sprite.png"
  },
  "files": [
    "lib",
    "preset",
    "client",
    "locale",
    "docs",
    "icon.png",
    "sprite.png",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test tests/runtime.test.mjs",
    "smoke": "node tools/smoke-client.mjs && node --input-type=module tools/smoke-presets.mjs",
    "sprite": "python tools/make-sprite.py",
    "preview": "python tools/make-preview.py",
    "check": "node --check lib/index.js && node --check lib/runtime.js && node --check lib/dsh-modules.js && node --check lib/art-store.mjs && node --check preset/kaka-memory.mjs && node --check preset/kaka-voice.mjs && node --check preset/kaka-draw.mjs && node --check client/client.js",
    "smoke:client": "node tools/smoke-client.mjs",
    "smoke:presets": "node --input-type=module tools/smoke-presets.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
